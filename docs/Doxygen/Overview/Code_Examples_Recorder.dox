@section example_rec_10MPSnapshotWithLCAC 10MPSnapshotWithLCACandEdgeSmooth

This is example session with 10MP JPEG snapshot with post processing.  
 Post processing pipe is Bayer LCAC, Bayer to YUV post processing,
 edge smooth and JPEG.

\code{.cpp}

#include <qmmf-sdk/qmmf_recorder.h>
#include <qmmf-sdk/qmmf_recorder_extra_param_tags.h>

using namespace android;
using namespace qmmf;
using namespace qmmf::recorder;

// Client recorder instance
Recorder recorder;

// Callbacks from the recorder service
RecorderCb recorder_cb;
recorder_cb.event_cb = [&](EventType event_type, void *event_data, 
                               size_t event_data_size) -> void
    { /* Handle incoming events from recorder */  };

// Connect to recorder service
recorder.Connect(recorder_cb);

// Retrive list of supported camera devices
SupportedCameras supported_cameras;
recorder.GetNumberOfCameras(supported_cameras);

// ID of the camera device that we want to open
uint32_t camera_id = 0;

bool match = false;

// Check if the ID of the camera device that we want to open is supported
for (auto const& camera : supported_cameras) {
  if ((unsigned)camera.id == camera_id) {
    match = true;
    break;
  }
}

if (!match) {
  // Failed to find the desired camera device, handle error.
}

// Starting parameters of the camera
CameraStartParam camera_params {};
camera_params.zsl_mode        = false;
camera_params.zsl_queue_depth = 10;
camera_params.zsl_width       = 1920;
camera_params.zsl_height      = 1080;
camera_params.frame_rate      = 30;
camera_params.flags           = 0x0;

// Open camera device
recorder.StartCamera(camera_id, camera_params);

SessionCb session_status_cb;
session_status_cb.event_cb = [&](EventType event_type, void *event_data,
                                     size_t event_data_size) -> void {
    // Handle incoming events for the session like state changes 
    // i.e. to indicate start, stop, pause state transition completions
};

uint32_t session_id;
recorder.CreateSession(session_status_cb, &session_id);

TrackCb video_track_cb;
video_track_cb.event_cb = [&](uint32_t track_id, EventType event_type,
                                  void *event_data, size_t event_data_size) {
    // Handling incoming events.
};

uint32_t video_track_id = 1;

VideoTrackCreateParam video_track_param {
  camera_id, VideoFormat::kAVC, 640, 480, 30
};

video_track_param.low_power_mode = false;

video_track_cb.data_cb = [&](uint32_t track_id,
                                 std::vector<BufferDescriptor> buffers,
                                 std::vector<MetaData> meta_buffers) {
    // Handles buffers and return them back to the service.
    recorder.ReturnTrackBuffer(session_id, track_id, buffers);
};

recorder.CreateVideoTrack(session_id, video_track_id,
                                   video_track_param, video_track_cb);

recorder.StartSession(session_id);

// Record for sometime

ImageParam image_param{};
image_param.width         = 3872;
image_param.height        = 2592;
image_param.image_format  = ImageFormat::kJPEG;
image_param.image_quality = 75; // JPEG quality (0-100)

std::vector<CameraMetadata> meta_array;
CameraMetadata meta;

recorder.GetDefaultCaptureParam(camera_id, meta);

meta_array.push_back(meta);

ImageCaptureCb cb = [&](uint32_t cam_id, uint32_t image_count,
                              BufferDescriptor buffer,
                              MetaData meta_data) -> void {
    // Handle image buffer and return it back to the service.
    recorder.ReturnImageCaptureBuffer(cam_id, buffer);
};

ImageConfigParam image_config;
PostprocPlugin bayer_lcac_plugin, edge_smooth_plugin, haze;

SupportedPlugins supported_plugins;
recorder.GetSupportedPlugins(&supported_plugins);

for (auto const& plugin_info : supported_plugins) {
  if (plugin_info.name == "BayerLcac") {
    recorder.CreatePlugin(&bayer_lcac_plugin.uid, plugin_info);

    image_config.Update(QMMF_POSTPROCESS_PLUGIN, bayer_lcac_plugin, 0);
  }
}

for (auto const& plugin_info : supported_plugins) {
  if (plugin_info.name == "EdgeSmooth") {
    recorder.CreatePlugin(&edge_smooth_plugin.uid, plugin_info);

    image_config.Update(QMMF_POSTPROCESS_PLUGIN, edge_smooth_plugin, 1);
  }
}

recorder.ConfigImageCapture(camera_id, image_config);

recorder.CaptureImage(camera_id, image_param, 1, meta_array, cb);

recorder.CancelCaptureImage(camera_id);

recorder.DeletePlugin(bayer_lcac_plugin.uid);

recorder.StopSession(session_id, false);

recorder.DeleteVideoTrack(session_id, video_track_id);

recorder.DeleteSession(session_id);

recorder.StopCamera(camera_id);

// Disconnect from recorder service
recorder.Disconnect();

\endcode
________________________________________________________________________________
@section example_rec_BurstSnapshotWithThumbnails BurstSnapshotWithThumbnails

This is example session with 1080p Burst JPEG snapshot with 
enabled first and secondary thumbnails.

\code{.cpp}

#include <qmmf-sdk/qmmf_recorder.h>
#include <qmmf-sdk/qmmf_recorder_extra_param_tags.h>

using namespace android;
using namespace qmmf;
using namespace qmmf::recorder;

// Client recorder instance
Recorder recorder;

// Callbacks from the recorder service
RecorderCb recorder_cb;
recorder_cb.event_cb = [&](EventType event_type, 
                               void *event_data,
                               size_t event_data_size) -> void
    { /* Handle incoming events from recorder */  };

// Connect to recorder service
recorder.Connect(recorder_cb);

// Retrive list of supported camera devices
SupportedCameras supported_cameras;
recorder.GetNumberOfCameras(supported_cameras);

// ID of the camera device that we want to open
uint32_t camera_id = 0;

bool match = false;

// Check if the ID of the camera device that we want to open is supported
for (auto const& camera : supported_cameras) {
  if ((unsigned)camera.id == camera_id) {
    match = true;
    break;
  }
}

if (!match) {
  // Failed to find the desired camera device, handle error.
}

// Starting parameters of the camera
CameraStartParam camera_params {};
camera_params.zsl_mode        = false;
camera_params.zsl_queue_depth = 10;
camera_params.zsl_width       = 1920;
camera_params.zsl_height      = 1080;
camera_params.frame_rate      = 30;
camera_params.flags           = 0x0;

// Open camera device
recorder.StartCamera(camera_id, camera_params);

ImageParam image_param{};
image_param.width         = 1920;
image_param.height        = 1080;
image_param.image_format  = ImageFormat::kJPEG;
image_param.image_quality = 75; // JPEG quality (0-100)

std::vector<CameraMetadata> meta_array;
CameraMetadata meta;

recorder.GetDefaultCaptureParam(camera_id, meta);

ImageCaptureCb cb = [&](uint32_t cam_id, uint32_t image_count,
                            BufferDescriptor buffer, MetaData meta_data) {
    // Handle image buffer and return it back to the service.
    recorder.ReturnImageCaptureBuffer(cam_id, buffer);
};

ImageConfigParam image_config;
ImageThumbnail thumbnail;

// Secondary thumbnail(Screennail) parameters.
thumbnail.width = 320;
thumbnail.height = 240;
thumbnail.quality = 85;
image_config.Update(QMMF_IMAGE_THUMBNAIL, thumbnail, 0);

// Primary thumbnail parameters.
thumbnail.width = 960;
thumbnail.height = 480;
thumbnail.quality = 90;
image_config.Update(QMMF_IMAGE_THUMBNAIL, thumbnail, 1);

recorder.ConfigImageCapture(camera_id, image_config);
uint32_t num_images = 10;

for (uint32_t i = 0; i < num_images; i++) {
  meta_array.push_back(meta);
}

recorder.CaptureImage(camera_id, image_param, num_images, meta_array, cb);

// Disconnect from recorder service
recorder.Disconnect();

\endcode

________________________________________________________________________________
@section example_rec_ContinuousSnapshotWithBayer ContinuousSnapshotWithBayerLCAC

This is example session with continuous capture with post processing.
 Post processing pipe is Bayer LCAC, Bayer to YUV post processing
 and JPEG with two thumbnails.

\code{.cpp}

#include <condition_variable>

#include <qmmf-sdk/qmmf_recorder.h>
#include <qmmf-sdk/qmmf_recorder_extra_param_tags.h>

using namespace android;
using namespace qmmf;
using namespace qmmf::recorder;

// Client recorder instance
Recorder recorder;

// Callbacks from the recorder service
RecorderCb recorder_cb;
recorder_cb.event_cb = [&](EventType event_type, void *event_data, 
                               size_t event_data_size) -> void
    { /* Handle incoming events from recorder */  };

// Connect to recorder service
recorder.Connect(recorder_cb);

// Retrive list of supported camera devices
SupportedCameras supported_cameras;
recorder.GetNumberOfCameras(supported_cameras);

// ID of the camera device that we want to open
uint32_t camera_id = 0;

bool match = false;

// Check if the ID of the camera device that we want to open is supported
for (auto const& camera : supported_cameras) {
  if ((unsigned)camera.id == camera_id) {
    match = true;
    break;
  }
}

if (!match) {
  // Failed to find the desired camera device, handle error.
}

// Starting parameters of the camera
CameraStartParam camera_params {};
camera_params.zsl_mode        = false;
camera_params.zsl_queue_depth = 10;
camera_params.zsl_width       = 1920;
camera_params.zsl_height      = 1080;
camera_params.frame_rate      = 30;
camera_params.flags           = 0x0;

// Open camera device
recorder.StartCamera(camera_id, camera_params);

const uint32_t preview_frame_rate = 30;
const uint32_t capture_frame_rate = 5;

std::condition_variable  ae_converge_signal;
std::mutex ae_converge_mutex;
bool ae_converged = false;

CameraResultCb result_cb = [&](uint32_t camera_id,
                                   const CameraMetadata &result) {
  if (result.exists(ANDROID_CONTROL_AE_STATE)) {
    uint8_t aec = result.find(ANDROID_CONTROL_AE_STATE).data.u8[0];
    if (((aec == ANDROID_CONTROL_AE_STATE_CONVERGED) ||
       (aec == ANDROID_CONTROL_AE_STATE_LOCKED))) {
      ae_converged = true;
      ae_converge_signal.notify_one();
    }
  }
};

recorder.StartCamera(camera_id, camera_params, result_cb);

SessionCb session_status_cb;
session_status_cb.event_cb = [&](EventType event_type, void *event_data,
                                     size_t event_data_size) -> void {
    // Handle incoming events for the session like state changes 
    // i.e. to indicate start, stop, pause state transition completions
};

uint32_t session_id;
recorder.CreateSession(session_status_cb, &session_id);

TrackCb video_track_cb;
video_track_cb.event_cb =  [&](uint32_t track_id, EventType event_type,
                                   void *event_data, size_t event_data_size) {
    // Handling incoming events.
};

uint32_t video_track_id = 1;

VideoTrackCreateParam video_track_param {
  camera_id, VideoFormat::kAVC, 640, 480, preview_frame_rate
};
video_track_param.low_power_mode = false;

video_track_cb.data_cb = [&](uint32_t track_id,
                                 std::vector<BufferDescriptor> buffers,
                                 std::vector<MetaData> meta_buffers) {
    // Handles buffers and return them back to the service.
    recorder.ReturnTrackBuffer(session_id, track_id, buffers);
};

recorder.CreateVideoTrack(session_id, video_track_id,
                                   video_track_param, video_track_cb);

recorder.StartSession(session_id);

ImageParam image_param{};
image_param.width         = 3872;
image_param.height        = 2592;
image_param.image_format  = ImageFormat::kJPEG;
image_param.image_quality = 75; // JPEG quality (0-100)

std::vector<CameraMetadata> meta_array;
CameraMetadata meta;

recorder.GetDefaultCaptureParam(camera_id, meta);

ImageCaptureCb cb = [&](uint32_t cam_id, uint32_t image_count,
                            BufferDescriptor buffer, MetaData meta_data) {
    // Handle image buffer and return it back to the service.
    recorder.ReturnImageCaptureBuffer(cam_id, buffer);
};

ImageConfigParam image_config;
PostprocPlugin bayer_lcac_plugin;

SupportedPlugins supported_plugins;
recorder.GetSupportedPlugins(&supported_plugins);
  
for (auto const& plugin_info : supported_plugins) {
  if (plugin_info.name == "BayerLcac") {
    recorder.CreatePlugin(&bayer_lcac_plugin.uid, plugin_info);

    image_config.Update(QMMF_POSTPROCESS_PLUGIN, bayer_lcac_plugin, 0);
  }
}

SnapshotType snapshot_type;
snapshot_type.type = SnapshotMode::kContinuous;
image_config.Update(QMMF_SNAPSHOT_TYPE, snapshot_type, 0);

// Ensure that preview and capture frame rate are multiple
// otherwise we cannot ensure persistent capture rate.

PostprocFrameSkip frame_skip;
frame_skip.frame_skip = (preview_frame_rate / capture_frame_rate) - 1;
image_config.Update(QMMF_POSTPROCESS_FRAME_SKIP, frame_skip, 0);

ImageThumbnail thumbnail;

// Secondary thumbnail(Screennail) parameters.
thumbnail.width = 320;
thumbnail.height = 240;
thumbnail.quality = 85;
image_config.Update(QMMF_IMAGE_THUMBNAIL, thumbnail, 0);

// Primary thumbnail parameters.
thumbnail.width = 960;
thumbnail.height = 480;
thumbnail.quality = 90;
image_config.Update(QMMF_IMAGE_THUMBNAIL, thumbnail, 1);

recorder.ConfigImageCapture(camera_id, image_config);

// Set frame rate otherwise default value is used
int32_t fps_range[2];
fps_range[0] = preview_frame_rate;
fps_range[1] = preview_frame_rate;
meta.update(ANDROID_CONTROL_AE_TARGET_FPS_RANGE, fps_range, 2);

meta_array.push_back(meta);

// Wait for AE convergence
{
  std::unique_lock<std::mutex> ae_converge_lock(ae_converge_mutex);
  std::chrono::seconds wait_time(30 / preview_frame_rate + 1);
  ae_converge_signal.wait(ae_converge_lock, [&]() { return ae_converged; });
}

CameraMetadata video_meta;
recorder.GetCameraParam(camera_id, video_meta);

// Lock AE for snapshot
uint8_t ae_lock = ANDROID_CONTROL_AE_LOCK_ON;
video_meta.update(ANDROID_CONTROL_AE_LOCK, &ae_lock, 1);

recorder.SetCameraParam(camera_id, video_meta);

recorder.CaptureImage(camera_id, image_param, 1, meta_array, cb);

// Capture images continuously for sometime.

recorder.CancelCaptureImage(camera_id);

recorder.DeletePlugin(bayer_lcac_plugin.uid);

recorder.StopSession(session_id, false);

recorder.DeleteVideoTrack(session_id, video_track_id);

recorder.DeleteSession(session_id);

recorder.StopCamera(camera_id);

// Disconnect from recorder service
recorder.Disconnect();

\endcode
________________________________________________________________________________
@section example_rec_RawBayerRDI12Snapshot RawBayerRDI12Snapshot

This is example session with BayerRDI (12 bits packed) snapshot.

\code{.cpp}

#include <qmmf-sdk/qmmf_recorder.h>

using namespace android;
using namespace qmmf;
using namespace qmmf::recorder;

// Client recorder instance
Recorder recorder;

// Callbacks from the recorder service
RecorderCb recorder_cb;
recorder_cb.event_cb = [&](EventType event_type, 
                               void *event_data,
                               size_t event_data_size) -> void
    { /* Handle incoming events from recorder */  };

// Connect to recorder service
recorder.Connect(recorder_cb);

// Retrive list of supported camera devices
SupportedCameras supported_cameras;
recorder.GetNumberOfCameras(supported_cameras);

// ID of the camera device that we want to open
uint32_t camera_id = 0;

bool match = false;

// Check if the ID of the camera device that we want to open is supported
for (auto const& camera : supported_cameras) {
  if ((unsigned)camera.id == camera_id) {
    match = true;
    break;
  }
}

if (!match) {
  // Failed to find the desired camera device, handle error.
}

// Starting parameters of the camera
CameraStartParam camera_params {};
camera_params.zsl_mode        = false;
camera_params.zsl_queue_depth = 10;
camera_params.zsl_width       = 1920;
camera_params.zsl_height      = 1080;
camera_params.frame_rate      = 30;
camera_params.flags           = 0x0;

// Open camera device
recorder.StartCamera(camera_id, camera_params);

camera_metadata_entry_t entry;
CameraMetadata meta;
int32_t width = 0, height = 0;

recorder.GetDefaultCaptureParam(camera_id, meta);

if (meta.exists(ANDROID_SCALER_AVAILABLE_RAW_SIZES)) {
  entry = meta.find(ANDROID_SCALER_AVAILABLE_RAW_SIZES);
  for (uint32_t i = 0 ; i < entry.count; i += 2) {
    width = entry.data.i32[i+0];
    height = entry.data.i32[i+1];
  }
}

ImageParam image_param{};
image_param.width        = width;
image_param.height       = height;
image_param.image_format = ImageFormat::kBayerRDI12BIT;

std::vector<CameraMetadata> meta_array;
meta_array.push_back(meta);

ImageCaptureCb cb = [&](uint32_t cam_id, uint32_t image_count,
                            BufferDescriptor buffer, MetaData meta_data) {
    // Handle image buffer and return it back to the service.
    recorder.ReturnImageCaptureBuffer(cam_id, buffer);
};

recorder.CaptureImage(camera_id, image_param, 1, meta_array, cb);

recorder.StopCamera(camera_id);

// Disconnect from recorder service
recorder.Disconnect();

\endcode
