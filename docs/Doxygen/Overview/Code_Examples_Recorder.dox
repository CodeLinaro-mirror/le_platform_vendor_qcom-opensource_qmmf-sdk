/*!

@page Code_Examples_Recorder Recorder

This tutorial demonstrates how to build a C++ sample application 
that can execute QMMF Recorder.

__Note__: While this sample code does not do any error checking, it 
is strongly recommended that users check for errors when using the QMMF APIs.

\n

@tableofcontents

________________________________________________________________________________
@section example_rec_StartStopCamera StartStopCamera

This is example code for starting and stopping 
the camera utilizing the QMMF APIs.

\code{.cpp}

#include <qmmf-sdk/qmmf_recorder.h>

using namespace qmmf::recorder;

// Client recorder instance
Recorder recorder;

// Callbacks from the recorder service
RecorderCb recorder_cb;
recorder_cb.event_cb = [&](EventType event_type, 
                               void *event_data,
                               size_t event_data_size) -> void
    { /* Handle incoming events from recorder */ };

// Connect to recorder service
recorder.Connect(recorder_cb);

// Retrive list of supported camera devices
SupportedCameras supported_cameras;
recorder.GetNumberOfCameras(supported_cameras);

// ID of the camera device that we want to open
uint32_t camera_id = 0;

bool match = false;

// Check if the ID of the camera device that we want to open is supported
for (auto const& camera : supported_cameras) {
  if ((unsigned)camera.id == camera_id) {
    match = true;
    break;
  }
}

if (!match) {
  // Failed to find the desired camera device, handle error.
}

// Starting parameters of the camera
CameraStartParam camera_params {};
camera_params.zsl_mode        = false;
camera_params.zsl_queue_depth = 10;
camera_params.zsl_width       = 1920;
camera_params.zsl_height      = 1080;
camera_params.frame_rate      = 30;
camera_params.flags           = 0x0;

// Open camera device
recorder.StartCamera(camera_id, camera_params);

// Close camera device
recorder.StopCamera(camera_id);

// Disconnect from recorder service
recorder.Disconnect();

\endcode

________________________________________________________________________________
@section example_rec_CreateDeleteSession CreateDeleteSession

This is example code for creating and deleting session 
utilizing the QMMF APIs.

\code{.cpp}

#include <qmmf-sdk/qmmf_recorder.h>

using namespace qmmf::recorder;

// Client recorder instance
Recorder recorder;

// Callbacks from the recorder service
RecorderCb recorder_cb;
recorder_cb.event_cb = [&](EventType event_type, 
                               void *event_data,
                               size_t event_data_size) -> void
    { /* Handle incoming events from recorder */  };

// Connect to recorder service
recorder.Connect(recorder_cb);

// Retrive list of supported camera devices
SupportedCameras supported_cameras;
recorder.GetNumberOfCameras(supported_cameras);

// ID of the camera device that we want to open
uint32_t camera_id = 0;

bool match = false;

// Check if the ID of the camera device that we want to open is supported
for (auto const& camera : supported_cameras) {
  if ((unsigned)camera.id == camera_id) {
    match = true;
    break;
  }
}

if (!match) {
  // Failed to find the desired camera device, handle error.
}

// Starting parameters of the camera
CameraStartParam camera_params {};
camera_params.zsl_mode        = false;
camera_params.zsl_queue_depth = 10;
camera_params.zsl_width       = 1920;
camera_params.zsl_height      = 1080;
camera_params.frame_rate      = 30;
camera_params.flags           = 0x0;

// Open camera device
recorder.StartCamera(camera_id, camera_params);

SessionCb session_status_cb;
session_status_cb.event_cb = [&](EventType event_type, void *event_data,
                                     size_t event_data_size) -> void {
    // Handle incoming events for the session like state changes 
    // i.e. to indicate start, stop, pause state transition completions
};

uint32_t session_id;

recorder.CreateSession(session_status_cb, &session_id);

recorder.DeleteSession(session_id);

// Close camera device
recorder.StopCamera(camera_id);

// Disconnect from recorder service
recorder.Disconnect();

\endcode

________________________________________________________________________________
@section example_rec_SessionWith1080pYUVTrack SessionWith1080pYUVTrack

This is example session with one 1080p YUV track.

\code{.cpp}

#include <qmmf-sdk/qmmf_recorder.h>

using namespace qmmf;
using namespace qmmf::recorder;

// Client recorder instance
Recorder recorder;

// Callbacks from the recorder service
RecorderCb recorder_cb;
recorder_cb.event_cb = [&](EventType event_type, 
                               void *event_data,
                               size_t event_data_size) -> void
    { /* Handle incoming events from recorder */  };

// Connect to recorder service
recorder.Connect(recorder_cb);

// Retrive list of supported camera devices
SupportedCameras supported_cameras;
recorder.GetNumberOfCameras(supported_cameras);

// ID of the camera device that we want to open
uint32_t camera_id = 0;

bool match = false;

// Check if the ID of the camera device that we want to open is supported
for (auto const& camera : supported_cameras) {
  if ((unsigned)camera.id == camera_id) {
    match = true;
    break;
  }
}

if (!match) {
  // Failed to find the desired camera device, handle error.
}

// Starting parameters of the camera
CameraStartParam camera_params {};
camera_params.zsl_mode        = false;
camera_params.zsl_queue_depth = 10;
camera_params.zsl_width       = 1920;
camera_params.zsl_height      = 1080;
camera_params.frame_rate      = 30;
camera_params.flags           = 0x0;

// Open camera device
recorder.StartCamera(camera_id, camera_params);

SessionCb session_status_cb;
session_status_cb.event_cb = [&](EventType event_type, void *event_data,
                                     size_t event_data_size) -> void {
    // Handle incoming events for the session like state changes 
    // i.e. to indicate start, stop, pause state transition completions
};

uint32_t session_id;
recorder.CreateSession(session_status_cb, &session_id);

VideoTrackCreateParam video_track_param {
  camera_id, VideoFormat::kYUV, 1920, 1080, 30
};

uint32_t video_track_id       = 1;

TrackCb video_track_cb;
video_track_cb.data_cb = [&](uint32_t track_id,
                                 std::vector<BufferDescriptor> buffers,
                                 std::vector<MetaData> meta_buffers) {
    // Handles buffers and return them back to the service.
    recorder.ReturnTrackBuffer(session_id, track_id, buffers);
};

video_track_cb.event_cb =  [&](uint32_t track_id, EventType event_type,
                                   void *event_data, size_t event_data_size) {
    // Handling incoming events.
};

recorder.CreateVideoTrack(session_id, video_track_id,
                                     video_track_param, video_track_cb);

recorder.StartSession(session_id);

// Let session run for time record_duration_, during this time buffer with
// valid data would be received in track callback (VideoTrackYUVDataCb).
// Record for sometime.

recorder.StopSession(session_id, false);

recorder.DeleteVideoTrack(session_id, video_track_id);

recorder.DeleteSession(session_id);

recorder.StopCamera(camera_id);

// Disconnect from recorder service
recorder.Disconnect();

\endcode
